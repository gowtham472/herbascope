# HerbaScope X ignore rules.
# Rule of thumb: source, configs and human-readable reports are committed;
# anything a pipeline script regenerates (datasets, embeddings, model binaries,
# runtime databases) is ignored. See docs/Architecture_Decisions.md (ADR-009).

# --- Environment files (secrets never committed; the template is) ---
.env*
!.env.example

# --- Node / Next.js (apps/web) ---
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Generated data (reproduced by `python -m scripts.run_pipeline`) ---
data/*
!data/README.md

# --- Generated model artifacts (reproduced by the training pipeline) ---
models/*
!models/README.md

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.pem
