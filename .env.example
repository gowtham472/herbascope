# HerbaScope X API configuration.
# Copy to `.env` in the repository root; the API reads it when started from the root.
# Relative paths resolve against the working directory.

# Model artifacts produced by `python -m scripts.run_pipeline`
MODEL_DIR=./models
REFERENCE_INDEX=./models/indexes/references.faiss
REFERENCE_METADATA=./models/indexes/reference_metadata.json

# Dataset root (reference images live under data/references/)
DATA_DIR=./data

# Runtime state: SQLite analysis history and normalised sample images
APP_STATE_DIR=./data/app

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
