# HerbaScope X API configuration.
# Copy to `.env` in the repository root; the API reads it when started from the root.
# Relative paths resolve against the working directory.

# Model release produced by `python -m scripts.run_pipeline`; artifacts are located through
# MODEL_DIR/manifest.json and verified by SHA-256 at startup.
MODEL_DIR=./models

# Dataset root (reference images live under data/references/)
DATA_DIR=./data

# Runtime state: SQLite analysis history and normalised sample images
APP_STATE_DIR=./data/app

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
